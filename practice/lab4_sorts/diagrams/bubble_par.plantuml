@startuml Bubble Sort Parallel
start
:Инициализация массива;
repeat
  :sorted = true;
  :// Чётная фаза;
  fork
    :Поток 1: сравнение (0,1);
    :Поток 2: сравнение (2,3);
    :Поток 3: сравнение (4,5);
    :...;
    :Поток k: сравнение (2k, 2k+1);
  end fork
  :// Нечётная фаза;
  fork
    :Поток 1: сравнение (1,2);
    :Поток 2: сравнение (3,4);
    :Поток 3: сравнение (5,6);
    :...;
    :Поток k: сравнение (2k+1, 2k+2);
  end fork
repeat while (sorted == false)
stop
@enduml