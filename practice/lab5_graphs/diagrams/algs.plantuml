@startuml Algorithms
!define RECTANGLE class

title Алгоритм Флойда-Уоршелла\n(последовательная и блочная параллельная версии)

package "Алгоритм Флойда-Уоршелла" {
    
    package "Внешний цикл по k (промежуточная вершина)" {
        RECTANGLE K_Loop {
            + k = 0..n-1
            + Последовательная зависимость
        }
    }
    
    package "Внутренние циклы" {
        RECTANGLE I_Loop {
            + i = 0..n-1 (начальная вершина)
            + Независимые итерации
        }
        
        RECTANGLE J_Loop {
            + j = 0..n-1 (конечная вершина)
            + Независимые итерации
        }
    }
    
    package "Вычислительное ядро" {
        RECTANGLE Core {
            + dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j])
        }
    }
    
    K_Loop --> I_Loop
    I_Loop --> J_Loop
    J_Loop --> Core
}

package "Блочная оптимизация" {
    RECTANGLE BlockDecomp {
        + Разбиение матрицы на блоки
        + Размер блока: BLOCK_SIZE
    }
    
    package "Фазы блочного алгоритма" {
        RECTANGLE Phase1 {
            + Фаза 1: диагональный блок
            + Зависимость: kk внутри блока
        }
        
        RECTANGLE Phase2 {
            + Фаза 2: блоки строки/столбца
            + Параллельные задачи
        }
        
        RECTANGLE Phase3 {
            + Фаза 3: остальные блоки
            + Максимальный параллелизм
        }
    }
    
    BlockDecomp --> Phase1
    Phase1 --> Phase2
    Phase2 --> Phase3
}

note right of K_Loop
  <b>Ключевая зависимость:</b>
  итерация k+1 требует
  завершения итерации k
end note

note right of I_Loop
  <b>Возможность распараллеливания:</b>
  все итерации i независимы
  при фиксированном k
end note

note bottom of BlockDecomp
  <b>Преимущества блочного подхода:</b>
  • улучшенная локальность кэша
  • уменьшение кэш-промахов
  • эффективное использование памяти
  • максимальное ускорение на многоядерных системах
end note

@enduml